# ============================================================
# MediaVault — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# DO NEVER COMMIT your .env file to Git.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Get these from: https://supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://yourproject.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── TMDB (Movies & TV) ───────────────────────────────────────
# Get a free key at: https://www.themoviedb.org/settings/api
VITE_TMDB_KEY=your-tmdb-key-here

# ── Google Books (optional) ──────────────────────────────────
# Without a key you still get 1000 free requests/day.
# Get a free key at: https://console.cloud.google.com
# Enable "Books API" in the API library.
VITE_GOOGLE_BOOKS_KEY=your-google-books-key-here

# ── Jikan (Anime & Manga) ────────────────────────────────────
# No key needed. Jikan is completely free.
# https://jikan.moe
